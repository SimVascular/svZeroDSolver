{
  "description": {
    "description of test case": "runs a simple 0D model of a cardiac chamber with inlet and outlet valves"
  },
  "boundary_conditions": [
    {
      "bc_name": "IN",
      "bc_type": "PRESSURE",
      "bc_values": {
        "P": [2000, 2000],
        "t": [0, 1]
      }
    },
    {
      "bc_name": "OUT",
      "bc_type": "PRESSURE",
      "bc_values": {
        "P": [1000, 1000],
        "t": [0, 1]
      }
    }
  ],
  "simulation_parameters": {
    "number_of_cardiac_cycles": 100,
    "number_of_time_pts_per_cardiac_cycle": 1000,
    "steady_initial": false,
    "output_variable_based": true,
    "absolute_tolerance": 1e-9,
    "output_all_cycles": true
  },
  "vessels": [
    {
      "boundary_conditions": {
        "inlet": "IN"
      },
      "vessel_id": 0,
      "vessel_length": 2.0,
      "vessel_name": "upstream_vessel",
      "zero_d_element_type": "BloodVessel",
      "zero_d_element_values": {
        "R_poiseuille": 0.0,
        "C": 1.0e-7
      }
    },
    {
      "boundary_conditions": {},
      "vessel_id": 1,
      "vessel_length": 1.0,
      "vessel_name": "ventricle",
      "zero_d_element_type": "ChamberSphere_growth",
      "zero_d_element_values": {
        "rho": 1e3,
        "thick0": 0.01,
        "radius0": 0.055,
        "C0": 1.9e3,
        "C1": 0.11,
        "C2": 1.9e3,
        "C3": 0.11,
        "eta": 10.0,
        "Theta_r": 1.0,
        "Theta_c": 1.0,
        "sigma_max": 0.0,
        "alpha_max": 0.0,
        "alpha_min": 0.0,
        "tsys": 0.17,
        "tdias": 0.484,
        "steepness": 0.005
      }
    },
    {
      "boundary_conditions": {},
      "vessel_id": 2,
      "vessel_length": 1.0,
      "vessel_name": "downstream_proximal_vessel",
      "zero_d_element_type": "BloodVessel",
      "zero_d_element_values": {
        "R_poiseuille": 8.0e6,
        "C": 2.5e-9
      }
    },
    {
      "boundary_conditions": {
        "outlet": "OUT"
      },
      "vessel_id": 3,
      "vessel_length": 1.0,
      "vessel_name": "downstream_distal_vessel",
      "zero_d_element_type": "BloodVessel",
      "zero_d_element_values": {
        "R_poiseuille": 1.0e8,
        "C": 1.0e-8
      }
    }
  ],
  "valves": [
    {
      "type": "ValveTanh",
      "name": "inlet_valve",
      "params": {
        "Rmax": 7e9,
        "Rmin": 1e-5,
        "Steepness": 2e-3,
        "upstream_block": "upstream_vessel",
        "downstream_block": "ventricle"
      }
    },
    {
      "type": "ValveTanh",
      "name": "outlet_valve",
      "params": {
        "Rmax": 8e9,
        "Rmin": 1e-5,
        "Steepness": 1e-3,
        "upstream_block": "ventricle",
        "downstream_block": "downstream_proximal_vessel"
      }
    }
  ],
  "junctions": [
    {
      "inlet_vessels": [2],
      "junction_name": "J0",
      "junction_type": "NORMAL_JUNCTION",
      "outlet_vessels": [3]
    }
  ]
}
